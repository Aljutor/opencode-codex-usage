{
  "name": "opencode-codex-usage",
  "version": "1.1.0",
  "description": "Codex quota probe with OpenCode sidebar and toast visibility",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aljutor/opencode-codex-usage.git"
  },
  "homepage": "https://github.com/Aljutor/opencode-codex-usage#readme",
  "bugs": {
    "url": "https://github.com/Aljutor/opencode-codex-usage/issues"
  },
  "keywords": [
    "opencode",
    "codex",
    "plugin",
    "quota",
    "tui"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "bin": {
    "opencode-codex-usage": "dist/bin/opencode-codex-usage.js"
  },
  "files": [
    "dist/bin/**/*.js",
    "dist/index.js",
    "dist/tui.js",
    "dist/lib/**/*.js",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/bin/opencode-codex-usage.js",
    "test": "npm run clean && tsc -p tsconfig.test.json && chmod +x dist/bin/opencode-codex-usage.js && node --test \"dist/tests/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.4",
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^25.3.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "solid-js": "^1.9.9",
    "zod": "^4.3.6"
  }
}
